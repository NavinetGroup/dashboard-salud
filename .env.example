# =================================================================
# Informe Regional de Salud — Configuración del despliegue
# Copia este archivo a .env y edita los valores reales
# El archivo .env está en .gitignore para que no se publique
# =================================================================

# ---- Hostname público del dashboard ----
HOSTNAME=informe-regional.supersalud.gov.co

# ---- TLS (HTTPS) — lo lee el Caddyfile, no hay que editarlo ----
# Opciones:
#   internal  → Caddy genera cert auto-firmado (solo pruebas: el navegador advierte)
#   file      → Usa cert + key entregados por IT (TLS_CERT_PATH / TLS_KEY_PATH)
#   acme      → Let's Encrypt automático (requiere DNS público y puertos 80/443 abiertos)
TLS_MODE=file
TLS_CERT_PATH=/etc/ssl/certs/informe-regional.crt
TLS_KEY_PATH=/etc/ssl/private/informe-regional.key
# Solo para TLS_MODE=acme
ACME_EMAIL=

# ---- Notificaciones del pipeline mensual ----
# Webhook (Teams/Slack). Si está poblado, tiene prioridad sobre el email.
NOTIFY_WEBHOOK_URL=
# Email: se envía con el comando `mail` de la VM, que necesita un MTA configurado
# (p. ej. msmtp o postfix como relay hacia el SMTP de Supersalud). Ver
# docs/DESPLIEGUE_SUPERSALUD.md. Recomendado: usar el webhook.
NOTIFY_EMAIL_TO=ops@navinetgroup.com

# ---- Ruta del proyecto en la VM ----
PROJECT_DIR=/opt/informe-regional
