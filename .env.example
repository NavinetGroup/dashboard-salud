# =================================================================
# Informe Regional de Salud — Configuración del despliegue
# Copia este archivo a .env y edita los valores reales
# El archivo .env está en .gitignore para que no se publique
# =================================================================

# ---- Hostname público del dashboard ----
HOSTNAME=informe-regional.supersalud.gov.co

# ---- TLS (HTTPS) ----
# Opciones:
#   internal  → Caddy genera cert auto-firmado (default, dev/staging)
#   file      → Usa cert + key montados desde TLS_CERT_PATH / TLS_KEY_PATH (prod)
#   acme      → Let's Encrypt automático (requiere DNS público resolvible)
TLS_MODE=file
TLS_CERT_PATH=/etc/ssl/certs/informe-regional.crt
TLS_KEY_PATH=/etc/ssl/private/informe-regional.key

# ---- Notificaciones del pipeline mensual ----
# Email (opcional)
NOTIFY_EMAIL_TO=ops@navinetgroup.com
NOTIFY_EMAIL_FROM=informe-regional@supersalud.gov.co
SMTP_HOST=smtp.supersalud.gov.co
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook (opcional, Teams/Slack)
# Si está poblado, las notificaciones van por webhook EN VEZ del email
NOTIFY_WEBHOOK_URL=

# ---- Paths en la VM ----
PROJECT_DIR=/opt/informe-regional
PYTHON_VENV=/opt/informe-regional/.venv

# ---- GitHub Release source for the DB ----
# Solo cambiar si el repo migra a otro fork
DB_RELEASE_URL=https://github.com/NavinetGroup/dashboard-salud/releases/download/data-v1/informe_regional.duckdb
